// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  password      String
  role          String   @default("BUYER") // BUYER, SELLER, ADMIN
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profile       Profile?
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist?
  seller        Seller?
  accounts      Account[]
  sessions      Session[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  phone     String?
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Auth.js models for OAuth compatibility (future use)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// SELLER & STORE MANAGEMENT
// ============================================

model Seller {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  taxId            String?
  bankAccount      String?
  verificationStatus String  @default("PENDING")
  verificationDocuments String // JSON string array
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  stores           Store[]

  @@index([userId])
  @@index([verificationStatus])
}

model Store {
  id               String   @id @default(cuid())
  slug             String   @unique
  sellerId         String
  seller           Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name             String
  tagline          String?
  description      String
  category         String
  categoryLabel    String
  location         String
  productCount     Int      @default(0)
  featured         Boolean  @default(false)
  status           String   @default("PENDING_APPROVAL") // ACTIVE, SUSPENDED, PENDING_APPROVAL, REJECTED
  
  // Visual configuration
  coverGradient    String?
  coverAlt         String?
  themeGradient    String?
  themePattern     String?
  themeAccentText  String?
  
  // Storefront template configuration
  template         String   @default("minimal")
  heroTitle        String?
  heroDescription  String?
  heroCtaLabel     String?
  brandStoryTitle  String?
  brandStoryContent String?
  ambientMotion    Boolean  @default(false)
  density          String   @default("comfortable")
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  products         Product[]
  featuredCollectionIds String // JSON array of collection IDs

  @@index([slug])
  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([featured])
}

// ============================================
// PRODUCT CATALOGUE
// ============================================

model Category {
  id        String   @id @default(cuid())
  idString  String   @unique // e.g., "fashion", "technology"
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([idString])
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeName        String
  name             String
  description      String
  category         String
  categoryLabel    String
  price            Int      // Minor units (1000 = 10.00)
  currency         String   @default("USD")
  badge            String?  // NEW, FEATURED, TRENDING
  availability     String   @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK
  tags             String   // JSON array
  highlights       String   // JSON array
  collections      String   // JSON array of collection IDs
  
  // Image placeholder (will be replaced with real images)
  imageGradient    String
  imageAlt         String
  imageUrl         String?            // Future: real image URL
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  images           ProductImage[]
  inventory        Inventory?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]

  @@index([slug])
  @@index([storeId])
  @@index([category])
  @@index([availability])
  @@index([badge])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([order])
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

// ============================================
// CART & ORDERS
// ============================================

model Cart {
  id        String   @id @default(cuid())
  userId    String?  // null for guest carts
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String?  // null for empty carts
  storeName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items     CartItem[]

  @@index([userId])
  @@index([storeId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  storeId          String
  storeName        String
  status           String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  
  // Customer details
  customerName     String
  customerEmail    String
  customerPhone    String
  
  // Delivery address
  recipientName    String
  phone            String
  country          String
  city             String
  addressLine      String
  apartmentDetails String?
  deliveryInstructions String?
  
  // Pricing (in minor units)
  subtotal         Int
  shipping         Int         @default(0)
  tax              Int         @default(0)
  total            Int
  
  // Payment
  paymentMethod    String
  paymentStatus    String      @default("PENDING")
  paymentId        String?     // External payment gateway ID
  
  // Timestamps
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  confirmedAt      DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?

  // Relations
  items            OrderItem[]

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  productPrice Int     // Price at time of order (minor units)
  quantity    Int
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ============================================
// ADDRESSES
// ============================================

model Address {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName     String
  phone             String
  country           String
  city              String
  addressLine       String
  apartmentDetails  String?
  deliveryInstructions String?
  label             String   @default("OTHER") // HOME, OFFICE, OTHER
  isDefault         Boolean  @default(false)
  
  // Optional GPS coordinates
  latitude          Float?
  longitude         Float?
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([isDefault])
}

// ============================================
// REVIEWS & WISHLIST
// ============================================

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  title     String?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([rating])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Relations
  items     WishlistItem[]
}

model WishlistItem {
  id         String    @id @default(cuid())
  wishlistId String
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([wishlistId])
  @@index([productId])
  @@unique([wishlistId, productId])
}

// ============================================
// PAYMENTS (Future implementation)
// ============================================

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  amount      Int      // Minor units
  currency    String
  method      String
  status      String
  gatewayId   String?  // External payment gateway ID
  metadata    String?  // JSON string for additional data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

// ============================================
// PLATFORM SETTINGS (Future implementation)
// ============================================

model PlatformSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}
