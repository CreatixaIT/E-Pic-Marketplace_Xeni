# Database
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="your-auth-secret-here"

# Commerce Provider
NEXT_PUBLIC_COMMERCE_PROVIDER="xeni"

# Xeni Gateway API
XENI_API_BASE_URL="https://api.e-pic.co/api/public/v1"
XENI_AUTH_API_BASE_URL="https://api.e-pic.co/api/auth"
NEXT_PUBLIC_XENI_AUTH_API_BASE_URL="https://api.e-pic.co/api/auth"

# Xeni Seller Dashboard URL
# This is the URL where sellers are redirected when they click on seller-related links
# in E-Pic. The default is the existing Xeni domain, but this should be updated
# to the production Xeni domain when ready.
NEXT_PUBLIC_XENI_URL="https://xeni.xentroinfotech.com"
