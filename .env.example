# Database
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="your-auth-secret-here"

# Commerce Provider
NEXT_PUBLIC_COMMERCE_PROVIDER="xeni"

# Xeni Gateway API - Separated by endpoint type
# XENI_API_BASE_URL: Used for buyer commerce operations (cart, checkout, orders)
# XENI_PUBLIC_API_BASE_URL: Used for public marketplace data (products, stores, categories)
# XENI_AUTH_API_BASE_URL: Used for authentication (register, login, verify-email, password-reset)
# NEXT_PUBLIC_XENI_AUTH_API_BASE_URL: Client-side authentication calls
# NEXT_PUBLIC_XENI_URL: Xeni seller dashboard and frontend URL

# Local Development
# XENI_API_BASE_URL="http://localhost:8080/api"
# XENI_PUBLIC_API_BASE_URL="http://localhost:8080/api/public/v1"
# XENI_AUTH_API_BASE_URL="http://localhost:8080/api/auth"
# NEXT_PUBLIC_XENI_AUTH_API_BASE_URL="http://localhost:8080/api/auth"
# NEXT_PUBLIC_XENI_URL="http://localhost:3000"

# Production (Update with actual production URLs)
XENI_API_BASE_URL="https://api.e-pic.co/api"
XENI_PUBLIC_API_BASE_URL="https://api.e-pic.co/api/public/v1"
XENI_AUTH_API_BASE_URL="https://api.e-pic.co/api/auth"
NEXT_PUBLIC_XENI_AUTH_API_BASE_URL="https://api.e-pic.co/api/auth"
NEXT_PUBLIC_XENI_URL="https://xeni.example.com"
